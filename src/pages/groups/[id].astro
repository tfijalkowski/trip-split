---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import CopyButton from "@/components/groups/CopyButton";
import GroupExpensesIsland from "@/components/expenses/GroupExpensesIsland";
import type { Group, GroupMember, ExpenseWithParticipants, MemberBalance } from "@/types";

const { supabase, user } = Astro.locals;
const { id } = Astro.params;

if (!supabase || !id || !user) {
  return Astro.redirect("/dashboard");
}

const { data: group } = await supabase.from("groups").select("*").eq("id", id).single<Group>();

if (!group) {
  return Astro.redirect("/dashboard");
}

const { data: membership } = await supabase
  .from("group_members")
  .select("id")
  .eq("group_id", id)
  .eq("user_id", user.id)
  .maybeSingle();

if (!membership) {
  return Astro.redirect("/dashboard");
}

const { data: memberRows, error: membersError } = await supabase
  .from("group_members")
  .select("id, group_id, user_id, created_at")
  .eq("group_id", id);

if (membersError) {
  return Astro.redirect("/dashboard?error=load_failed");
}

const userIds = memberRows.map((m: { user_id: string }) => m.user_id);

const { data: profileRows, error: profilesError } = userIds.length
  ? await supabase.from("profiles").select("id, display_name, email").in("id", userIds)
  : { data: [] as { id: string; display_name: string | null; email: string }[], error: null };

if (profilesError) {
  return Astro.redirect("/dashboard?error=load_failed");
}

const profileMap = new Map(
  profileRows.map((p: { id: string; display_name: string | null; email: string }) => [p.id, p]),
);

const members: GroupMember[] = memberRows.map(
  (m: { id: string; group_id: string; user_id: string; created_at: string }) => ({
    id: m.id,
    group_id: m.group_id,
    user_id: m.user_id,
    created_at: m.created_at,
    display_name: profileMap.get(m.user_id)?.display_name ?? null,
    email: profileMap.get(m.user_id)?.email ?? m.user_id,
  }),
);

const [{ data: expenseRows }, { data: balanceRows }] = await Promise.all([
  supabase
    .from("expenses")
    .select("*, expense_participants(*)")
    .eq("group_id", id)
    .order("expense_date", { ascending: false }),
  supabase.from("member_balances").select("*").eq("group_id", id),
]);

const initialExpenses = (expenseRows ?? []) as ExpenseWithParticipants[];
const initialBalances = (balanceRows ?? []) as MemberBalance[];

const inviteUrl = `${Astro.url.origin}/join/${group.invite_code}`;
---

<Layout title={group.name}>
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-8">
    <div class="w-full max-w-2xl">
      <div class="mb-8">
        <a href="/dashboard" class="text-sm text-blue-200/70 hover:text-blue-200">← Dashboard</a>
      </div>

      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {group.name}
      </h1>
      {group.description && <p class="mb-6 text-sm text-blue-100/60">{group.description}</p>}

      <div class="mb-6 rounded-xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
        <p class="mb-2 text-xs font-semibold tracking-wide text-white/50 uppercase">Invite link</p>
        <div class="flex items-center gap-3">
          <code class="flex-1 truncate rounded bg-black/20 px-3 py-2 text-sm text-blue-200">
            {inviteUrl}
          </code>
          <CopyButton value={inviteUrl} client:load />
        </div>
      </div>

      <div class="mb-6 rounded-xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
        <p class="mb-3 text-xs font-semibold tracking-wide text-white/50 uppercase">Members</p>
        <ul class="flex flex-col gap-2">
          {members.map((m) => <li class="text-sm text-white/80">{m.display_name ?? m.email}</li>)}
        </ul>
      </div>

      <GroupExpensesIsland
        groupId={id}
        initialExpenses={initialExpenses}
        initialBalances={initialBalances}
        members={members}
        currentUserId={user.id}
        client:load
      />
    </div>
  </div>
</Layout>
